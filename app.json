{
  "expo": {
    "name": "SmartChair",
    "slug": "smartchair-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "smartchair",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/png/logos/smartchair-mark.png",
    "splash": {
      "image": "./assets/png/logos/smartchair-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "android": {
      "package": "uz.smartchair.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/png/logos/smartchair-mark.png",
        "backgroundColor": "#0A0A0C"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "uz.smartchair.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SmartChair uses your location to show nearby barbershops and salons on the map."
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SmartChair to use your location to find nearby barbershops."
        }
      ],
      "expo-asset"
    ]
  }
}
