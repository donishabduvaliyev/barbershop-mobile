{
  "expo": {
    "name": "SmartChair",
    "slug": "smartchair-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "smartchair",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/branding/icon.png",
    "splash": {
      "image": "./assets/branding/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "android": {
      "package": "uz.smartchair.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "uz.smartchair.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SmartChair uses your location to show nearby barbershops and salons on the map."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf",
            "./assets/fonts/Fraunces-500.ttf",
            "./assets/fonts/Fraunces-600.ttf",
            "./assets/fonts/Fraunces-700.ttf",
            "./assets/fonts/Inter-400.ttf",
            "./assets/fonts/Inter-500.ttf",
            "./assets/fonts/Inter-600.ttf",
            "./assets/fonts/Inter-700.ttf",
            "./assets/fonts/Inter-800.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SmartChair to use your location to find nearby barbershops."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12dcb4b4-fd06-472d-882c-67f62d4354b3"
      }
    }
  }
}
