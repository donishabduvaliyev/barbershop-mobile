{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://barbershop-backend-1hf3.onrender.com",
        "EXPO_PUBLIC_API_URL": "https://barbershop-backend-1hf3.onrender.com",
        "EXPO_PUBLIC_TELEGRAM_BOT_USERNAME": "SmartChairUzBot"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://barbershop-backend-1hf3.onrender.com",
        "EXPO_PUBLIC_API_URL": "https://barbershop-backend-1hf3.onrender.com",
        "EXPO_PUBLIC_TELEGRAM_BOT_USERNAME": "SmartChairUzBot"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
